{
  "name": "{{ VersoriumX }}",
  "version": "1.0.0",
  "keywords": [
    {{#each keywords}}
    "{{ this }}",
    {{/each}}
    "ethereum",
    "vue",
    "workspaces",
    "yarn"
  ],
  "private": true,
  "scripts": {
    {{#with scripts }}
    {{#each keys }}
    "{{ this }}": "{{{lookup ../values @index }}}",
    {{/each }}
    {{/with }}
    "contracts:build": "yarn workspace {{ orgName }}/contracts forge:build",
    "contracts:test": "yarn workspace {{ orgName }}/contracts forge:test",
    "contracts:deploy": "yarn workspace {{ orgName }}/contracts forge:deploy",
    "vue-app:build": "yarn workspace {{ orgName }}/vue-app build",
    "vue-app:serve": "yarn workspace {{ orgName }}/vue-app serve"
  },
  "workspaces": {
    {{#if nohoist.length}}
    "nohoist": [
      {{#each nohoist}}
      "{{ this }}"{{#unless @last}},{{/unless}}
      {{/each}}
    ],
    {{/if}}
    "packages": [
      "packages/*"
    ]
  }
}
